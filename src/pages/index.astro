---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Tx from '../components/Tx.astro';
import { CHAPTERS, PARTS, chapterByNum } from '../data/catalog';
import type { ChapterExtras } from '../data/types';

const ready = new Set((await getCollection('chapters')).map((e) => chapterByNum(e.data.num)!.slug));
const first = CHAPTERS.find((c) => ready.has(c.slug));
const totalSections = CHAPTERS.filter((c) => ready.has(c.slug)).reduce((s, c) => s + c.sections.length, 0);
const parts = [1, 2, 3] as const;
const extrasModules = import.meta.glob<{ default: ChapterExtras }>('../data/chapters/ch*.ts', { eager: true });
const extras = new Map(Object.entries(extrasModules).map(([path, m]) => [Number(path.match(/ch(\d+)\.ts$/)![1]), m.default.practice.map((p) => p.id)]));
---
<BaseLayout title="DSA Mastery" active="chapters">
  <main id="main" class="page">
    <section class="hero">
      <div>
        <h1>From intermediate to <em>expert</em>, one chapter at a time.</h1>
        <p>
          <Tx v={{
            en: 'An interactive companion to Competitive Programmer’s Handbook: every idea explained in English and Hinglish, every algorithm in tested Java, and step-through visualisers you can feed your own input.',
            hi: 'Competitive Programmer’s Handbook ka interactive saathi: har idea English aur Hinglish mein, har algorithm tested Java mein, aur aise visualisers jinhe tum apna input dekar step-by-step chala sakte ho.',
          }} />
        </p>
        <div class="hero-actions">
          {first && (
            <a class="btn primary" href={`/chapters/${first.slug}/`} data-continue>
              <span data-continue-label><Tx ui v={{ en: `Start with ${first.num}. ${first.title}`, hi: `${first.num}. ${first.title} se shuru karo` }} /></span> →
            </a>
          )}
          <a class="btn" href="/about/"><Tx ui v={{ en: 'How to study here', hi: 'Yahan kaise padhein' }} /></a>
        </div>
      </div>
      <div class="hero-card">
        <div class="stat-row">
          <div class="stat"><b data-stat="sections">0</b><small><Tx ui v={{ en: `of ${totalSections} sections done`, hi: `${totalSections} mein se sections done` }} /></small></div>
          <div class="stat"><b data-stat="streak">0</b><small><Tx ui v={{ en: 'day streak', hi: 'din ki streak' }} /></small></div>
          <div class="stat"><b data-stat="solved">0</b><small><Tx ui v={{ en: 'CSES solved', hi: 'CSES solved' }} /></small></div>
        </div>
        <div>
          <div class="meter-label"><span><Tx ui v={{ en: 'Study activity · last 16 weeks', hi: 'Study activity · pichhle 16 hafte' }} /></span></div>
          <div class="heatmap" data-heatmap aria-label="Days you studied in the last 16 weeks"></div>
        </div>
        <div class="account-card" data-when-signed-out>
          <p><Tx v={{ en: 'Progress is saved in this browser. Sign in to sync your progress, notes and CSES solutions across all your devices.', hi: 'Progress abhi sirf is browser mein save hai. Sign in karo toh progress, notes aur CSES solutions tumhare saare devices pe sync honge.' }} /></p>
          <button class="btn primary" type="button" data-signin><Tx ui v={{ en: 'Sign in with GitHub', hi: 'GitHub se sign in' }} /></button>
        </div>
        <div class="account-card" data-when-signed-in>
          <p class="sync-line"><span class="sync-dot" data-sync-dot data-state="off"></span><span>Signed in as <b data-login></b> · <span data-sync-text></span></span></p>
          <a class="btn" href="/me/"><Tx ui v={{ en: 'My study: notes, solutions, export', hi: 'My study: notes, solutions, export' }} /> →</a>
        </div>
      </div>
    </section>

    {parts.map((part) => (
      <section class="part" aria-labelledby={`part-${part}`}>
        <div class="part-head">
          <span class="part-no">PART {part === 1 ? 'I' : part === 2 ? 'II' : 'III'}</span>
          <h2 id={`part-${part}`}>{PARTS[part].title}</h2>
          <p><Tx v={PARTS[part].blurb} /></p>
        </div>
        <div class="cards">
          {CHAPTERS.filter((c) => c.part === part).map((c) => {
            const live = ready.has(c.slug);
            const Tag = live ? 'a' : 'div';
            return (
              <Tag class={`card${live ? '' : ' soon'}`} href={live ? `/chapters/${c.slug}/` : undefined} data-chapter-title={c.slug} data-title={`${c.num}. ${c.title}`}>
                <span class="num">{String(c.num).padStart(2, '0')}</span>
                {c.condensed && <span class="chip badge"><Tx ui v={{ en: 'quick revision', hi: 'quick revision' }} /></span>}
                {!live && <span class="chip badge"><Tx ui v={{ en: 'coming soon', hi: 'jald aa raha' }} /></span>}
                <h3>{c.title}</h3>
                <p><Tx v={c.blurb} /></p>
                {live && (
                  <div class="card-foot" data-progress-chapter={c.slug} data-total={c.sections.length} data-cses-ids={(extras.get(c.num) ?? []).join(',')}>
                    <div class="meter-label"><span data-progress-text>0/{c.sections.length}</span><span><span data-quiz-text></span> <span data-solved-text></span></span></div>
                    <div class="meter"><span></span></div>
                  </div>
                )}
              </Tag>
            );
          })}
        </div>
      </section>
    ))}
  </main>
</BaseLayout>
